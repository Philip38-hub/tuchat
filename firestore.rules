rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipantInList(participants) {
      return isSignedIn()
        && participants is list
        && request.auth.uid in participants;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isCurrentUser(userId);
      allow delete: if false;

      match /contacts/{contactId} {
        allow read, update: if isCurrentUser(userId);
        allow create: if isCurrentUser(userId)
          || (
            isSignedIn()
            && contactId == request.auth.uid
            && request.resource.data.uid == request.auth.uid
          );
        allow delete: if false;
      }
    }

    match /chats/{chatId} {
      allow create: if isParticipantInList(request.resource.data.participants);
      allow read: if isParticipantInList(resource.data.participants);
      allow update: if isSignedIn()
        && (
          isParticipantInList(resource.data.participants)
          || isParticipantInList(request.resource.data.participants)
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantInList(
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isParticipantInList(
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isParticipantInList(
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow delete: if false;
      }
    }
  }
}
